---
import '../../src/styles/styles.css'
interface Props { title?: string; description?: string; ogDescription?: string }
const {
    title = 'Fernando Falcon — Web Designer & Developer',
    description = 'Fernando Falcon — web designer and developer in Montevideo, Uruguay. Interface design, responsive websites, and graphic design with over 15 years of experience.',
    ogDescription = 'A designer’s eye. A developer’s mindset. Explore Fernando Falcon’s design work and experience.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
        <link rel="preload" href="/fonts/archivo-variable.ttf" as="font" type="font/ttf" crossorigin />
        <meta name="description" content={description} />
        <meta name="color-scheme" content="light dark" />
        <meta name="theme-color" content="#0a66c2" media="(prefers-color-scheme: light)" />
        <meta name="theme-color" content="#101c29" media="(prefers-color-scheme: dark)" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={ogDescription} />
        <meta property="og:type" content="website" />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
