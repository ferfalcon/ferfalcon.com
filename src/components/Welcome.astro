---
import Arrow from './Arrow.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import WorkflowPath from './WorkflowPath.astro';
const experience = [
  { company: 'AgileCommerce', role: 'Web Designer · Technical Leader', dates: '2016 — 2024', description: 'E-commerce interfaces, responsive websites, and scalable CSS architecture.' },
  { company: 'WinTrillions / Trillonario', role: 'Web & Graphic Designer', dates: '2013 — 2016', description: 'Landing pages, email campaigns, and design for digital and print.' },
  { company: 'INES CRM', role: 'Web & Graphic Designer', dates: '2011 — 2013', description: 'Web application interfaces, CSS frameworks, and marketing design.' },
];

---
<a class="skip-link" href="#main">Skip to content</a>
<div class="opening opening-home" id="top">
  <SiteHeader home />
  <main id="main" tabindex="-1">
    <section class="hero wrap">
      <div class="hero-copy">
        <h1>Designed well.<br />Built right.</h1>
        <p class="intro">I’m Fernando Falcon, a <strong>web designer & developer</strong> in Montevideo. I bring a designer’s eye and a developer’s mindset to the web.</p>
        <div class="hero-actions"><a class="button button-dark" href="#work">Explore my work <Arrow direction="down" /></a><a class="text-link" href="mailto:fer.falcon.dg@gmail.com">Get in touch <Arrow /></a></div>
      </div>
      <div class="type-specimen">
        <div class="specimen-top"><span>Design meets code</span><span class="specimen-swatch" aria-hidden="true"></span></div>
        <div class="card-stage">
          <svg class="blueprint-card" viewBox="0 0 400 300" role="img" aria-labelledby="card-title card-description">
            <title id="card-title">Interface card blueprint</title>
            <desc id="card-description">A rounded interface card with a circular avatar and three placeholder text lines, layered with diagonal hatching and drafting guides.</desc>
            <defs>
              <pattern id="card-hatch" width="10" height="10" patternUnits="userSpaceOnUse" patternTransform="rotate(35)">
                <path d="M 0 0 V 10" class="card-hatch-line" />
              </pattern>
            </defs>
            <g class="card-dimensions">
              <path d="M40 78 V58 M360 78 V58 M40 68 H360 M28 90 H8 M28 224 H8 M18 90 V224 M40 236 V256 M360 236 V256 M40 246 H360" />
              <path d="m36 72 8-8 m312 8 8-8 M14 94 l8-8 M14 228 l8-8 m17 22 8-8 m312 8 8-8" />
              <path class="card-guides" d="M74 80 V234 M110 80 V234 M30 131 H370 M30 171 H370" />
            </g>
            <g class="card-annotations">
              <text x="200" y="48" text-anchor="middle">FORM / FUNCTION</text>
              <text x="200" y="274" text-anchor="middle">DESIGNED TO WORK</text>
            </g>
            <rect x="40" y="90" width="320" height="134" rx="8" class="card-surface" />
            <rect x="40" y="90" width="320" height="134" rx="8" fill="url(#card-hatch)" class="card-shell" />
            <g class="card-details">
              <circle cx="74" cy="143" r="20" class="card-placeholder" />
              <rect x="110" y="126" width="180" height="13" rx="3" class="card-placeholder" />
              <rect x="110" y="153" width="235" height="13" rx="3" class="card-placeholder" />
              <rect x="110" y="177" width="200" height="13" rx="3" class="card-placeholder" />
            </g>
          </svg>
        </div>
        <div class="specimen-controls" hidden>
          <div class="specimen-label"><label for="card-size">Card size</label><output for="card-size" id="card-size-value">100%</output></div>
          <input type="range" min="65" max="100" value="100" step="1" id="card-size" aria-describedby="specimen-hint" />
          <div class="specimen-label"><label for="hatch-spacing">Hatch spacing</label><output for="hatch-spacing" id="hatch-spacing-value">10</output></div>
          <input type="range" min="5" max="20" value="10" step="1" id="hatch-spacing" aria-describedby="specimen-hint" />
          <p id="specimen-hint">A little design play. Adjust the scale and rhythm.</p>
        </div>
        <noscript><p class="specimen-static">Form meets function. Built to the details.</p></noscript>
      </div>
      <div class="hero-baseline"><p>Thoughtful interfaces. Responsive websites. Visual identities.</p><span>Based in Uruguay</span></div>
    </section>
    <div class="page-body">
      <section class="work-section wrap section-space" id="work">
        <div class="section-heading"><h2>From the<br />design desk.</h2><p>A selection from my portfolio.<br />Visual systems and interfaces, down to the details.</p></div>
        <div class="work-grid">
          <article class="project project-campo">
            <a class="project-visual campo-visual" href="/work/del-campo/" aria-label="Explore Del Campo case study">
              <img src="/images/work/del-campo-system.webp" alt="Del Campo Stores design board with its logo, warm color palette, typography, and interface components" width="1440" height="1024" loading="lazy" decoding="async" />
              <span class="image-action" aria-hidden="true"><Arrow /></span>
            </a>
            <div class="project-info"><h3>Del Campo Stores</h3><p>Website design &amp; platform implementation</p><a class="text-link project-case-link" href="/work/del-campo/">Explore Del Campo <Arrow /></a></div>
          </article>
          <article class="project project-elio">
            <a class="project-visual elio-visual" href="/work/elio/" aria-label="Explore Elio case study">
              <img class="elio-screen elio-screen-front" src="/images/work/elio-form.webp" alt="Elio mobile interface with an aqua color palette, labeled inputs, and symptom selection" width="800" height="1972" loading="lazy" decoding="async" />
              <img class="elio-screen elio-screen-back" src="/images/work/elio-results.webp" alt="" width="800" height="2320" loading="lazy" decoding="async" />
              <span class="image-action" aria-hidden="true"><Arrow /></span>
            </a>
            <div class="project-info"><h3>Elio</h3><p>Product design &amp; frontend implementation</p><a class="text-link project-case-link" href="/work/elio/">Explore Elio <Arrow /></a></div>
          </article>
        </div>
        <div class="work-footer"><p>More design on Behance. More code on GitHub.</p><div><a class="text-link" href="https://www.behance.net/ferfalcon">Behance <Arrow /></a><a class="text-link" href="https://github.com/ferfalcon">GitHub <Arrow /></a></div></div>
      </section>
      <section class="workflow-feature" id="workflow" aria-labelledby="workflow-title">
        <div class="wrap section-space">
          <div class="workflow-feature-heading">
            <h2 id="workflow-title">Figma to<br />Implementation.</h2>
            <div class="workflow-feature-copy"><p class="workflow-lead">A design is the starting point.<br />Reviewed code is the result.</p><p>An evidence-driven workflow connecting design sources, implementation decisions, code, and review. Real frontend projects show both completed work and unresolved findings.</p><a class="text-link" href="/work/figma-to-implementation-workflow/">Explore the workflow <Arrow /></a></div>
          </div>
          <WorkflowPath />
          <div class="workflow-feature-footer"><p>Astro &amp; TypeScript examples · WordPress validation candidate</p><a class="text-link" href="https://github.com/ferfalcon/figma-to-implementation-workflow">View on GitHub <Arrow /></a></div>
        </div>
      </section>
      <section class="about-section" id="about">
        <div class="wrap about-grid section-space">
          <div class="about-heading"><h2>A designer<br />who builds.</h2><a class="text-link" href="/fer-falcon-resume.pdf" download>Download resume <Arrow direction="down" /></a></div>
          <div class="about-copy">
            <p class="about-lead">Good ideas deserve to work beautifully.</p>
            <p>I’m Fernando, a web and graphic designer with over 15 years of experience across interface design, web development, and visual communication.</p>
            <p>My work connects the visual details with the way a website is built: clear interfaces, responsive layouts, and CSS that holds up as a project grows.</p>
            <dl class="capabilities"><div><dt>Design</dt><dd>UI design, visual systems, graphic design, Figma</dd></div><div><dt>Development</dt><dd>HTML, CSS, JavaScript, TypeScript, React</dd></div><div><dt>Perspective</dt><dd>E-commerce, design leadership, cross-functional collaboration</dd></div></dl>
          </div>
        </div>
      </section>
      <section class="experience-section wrap section-space">
        <div class="section-heading"><h2>Experience<br />in practice.</h2><p>Design, development, and the space between.<br />Selected roles from my professional journey.</p></div>
        <ul class="experience-list" role="list">{experience.map((item) => <li><div><h3>{item.company}</h3><p>{item.role}</p></div><p class="experience-description">{item.description}</p><span class="experience-dates">{item.dates}</span></li>)}</ul>
        <a class="text-link experience-resume" href="/resume/">Explore my full résumé <Arrow /></a>
      </section>
      <section class="contact-section" id="contact">
        <div class="wrap contact-inner">
          <h2>Something in mind?<br /><a href="mailto:fer.falcon.dg@gmail.com">Let’s make it real.<Arrow /></a></h2>
          <div class="contact-bottom"><p>A project, a role, or a good conversation.<br />I’d love to hear about it.</p><a class="email-link" href="mailto:fer.falcon.dg@gmail.com">fer.falcon.dg@gmail.com</a></div>
        </div>
      </section>
    </div>
  </main>
</div>
<SiteFooter />
<script>
  const size = document.querySelector<HTMLInputElement>('#card-size');
  const spacing = document.querySelector<HTMLInputElement>('#hatch-spacing');
  const card = document.querySelector<SVGSVGElement>('.blueprint-card');
  const hatch = document.querySelector<SVGPatternElement>('#card-hatch');
  const hatchLine = document.querySelector<SVGPathElement>('.card-hatch-line');
  const sizeOutput = document.querySelector<HTMLOutputElement>('#card-size-value');
  const spacingOutput = document.querySelector<HTMLOutputElement>('#hatch-spacing-value');
  const controls = document.querySelector<HTMLElement>('.specimen-controls');
  if (size && spacing && card && hatch && hatchLine && sizeOutput && spacingOutput && controls) {
    controls.hidden = false;
    const update = () => {
      card.style.inlineSize = `${size.value}%`;
      sizeOutput.value = `${size.value}%`;
      hatch.setAttribute('width', spacing.value);
      hatch.setAttribute('height', spacing.value);
      hatchLine.setAttribute('d', `M 0 0 V ${spacing.value}`);
      spacingOutput.value = spacing.value;
    };
    size.addEventListener('input', update);
    spacing.addEventListener('input', update);
    update();
  }
</script>
