---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Arrow from '../components/Arrow.astro';

// Career details: docs/cv.md. Positioning and project scope: ../Vault/website-brief.md.
const experience = [
  { company: 'AgileCommerce', role: 'Web Designer · Technical Leader', dates: 'March 2016 — July 2024', location: 'Montevideo, Uruguay', points: [
    'Designed and implemented UX/UI for e-commerce solutions using nopCommerce.',
    'Developed and maintained scalable CSS architecture for responsive layouts and consistent styling across web platforms.',
    'Collaborated with developers and project managers to connect interface design with backend technologies.',
  ] },
  { company: 'WinTrillions / Trillonario', role: 'Web & Graphic Designer', dates: 'March 2013 — February 2016', location: 'Montevideo, Uruguay', points: [
    'Designed landing pages and email marketing campaigns for an international lottery and gaming platform.',
    'Created social media graphics, web advertising, brochures, and print materials aligned with brand guidelines.',
  ] },
  { company: 'INES CRM', role: 'Web & Graphic Designer', dates: 'December 2011 — February 2013', location: 'Lyon, France', points: [
    'Designed web application interfaces and CSS frameworks to standardize web page production.',
    'Created landing pages, email designs, and social media graphics for marketing campaigns.',
  ] },
  { company: 'BIOS', role: 'Teacher', dates: 'June 2009 — February 2013', location: 'Montevideo, Uruguay', points: [
    'Taught Adobe Creative Suite courses, including Photoshop, Illustrator, InDesign, Dreamweaver, and Flash.',
  ] },
  { company: 'Prometeo Design', role: 'Freelance Web & Graphic Designer', dates: 'August 2007 — December 2013', location: 'Montevideo, Uruguay', points: [
    'Delivered custom website, graphic design, and branding projects, managing work from concept through completion.',
  ] },
  { company: 'Gproxy', role: 'Web Designer', dates: 'January 2004 — April 2006', location: 'Miami, USA', points: [
    'Developed and maintained websites for e-commerce solutions using the NetSuite platform.',
  ] },
];
const skills = [
  { label: 'Design', text: 'Interface design, responsive layouts, visual systems, graphic design, Figma, Photoshop, Illustrator' },
  { label: 'Frontend', text: 'HTML, CSS, JavaScript, TypeScript, React, Angular, Sass / Less' },
  { label: 'Development', text: 'Node.js, Python, SQL, C, Bash, Fastify, Express, Prisma ORM' },
  { label: 'Platforms & collaboration', text: 'nopCommerce, WordPress, Joomla, GitHub, Visual Studio Code, ClickUp, Asana' },
];
const description = 'Fernando Falcon’s résumé: interface design, frontend implementation, e-commerce experience, education, and skills. Based in Montevideo, Uruguay.';
---
<Layout title="Résumé — Fernando Falcon" description={description} ogDescription={description}>
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="opening" id="top">
    <SiteHeader resume />
    <div class="resume-heading wrap">
      <p class="eyebrow">Résumé / Design & development</p>
      <h1>Fernando Falcon<span>.</span></h1>
      <p class="resume-role">A designer who codes.</p>
      <p class="resume-summary">I bring over 15 years of experience in interface design, web development, and visual communication to product UI and responsive websites—with hands-on frontend implementation.</p>
      <div class="hero-actions"><a class="button button-dark" href="/fer-falcon-resume.pdf" download>Download résumé <span class="file-type">PDF</span><Arrow direction="down" /></a><a class="text-link" href="mailto:fer.falcon.dg@gmail.com">Get in touch <Arrow /></a></div>
      <div class="resume-availability"><p>Montevideo, Uruguay</p><p>Open to remote opportunities & relocation</p></div>
    </div>
  </div>
  <main id="main" class="wrap resume-body" tabindex="-1">
    <aside class="resume-sidebar" aria-label="Contact and résumé sections">
      <div class="resume-contact"><h2>Contact</h2><a href="mailto:fer.falcon.dg@gmail.com">fer.falcon.dg@gmail.com</a><a href="tel:+59898641792">+598 98 641 792</a><a href="https://www.linkedin.com/in/fernandofalcon/">LinkedIn <Arrow /></a><a href="https://github.com/ferfalcon">GitHub <Arrow /></a></div>
      <nav class="resume-index" aria-label="On this page"><h2>On this page</h2><a href="#experience">Experience</a><a href="#projects">Selected work</a><a href="#skills">Skills</a><a href="#education">Education</a><a href="#languages">Languages</a></nav>
    </aside>
    <div class="resume-content">
      <section id="experience" aria-labelledby="experience-title">
        <h2 id="experience-title">Work experience</h2>
        <p class="section-note">From e-commerce interfaces to design leadership and teaching.</p>
        <ol class="resume-jobs" role="list">{experience.map((job) => <li><article><div class="job-heading"><div><h3>{job.company}</h3><p class="job-role">{job.role}</p></div><div class="job-meta"><p>{job.dates}</p><p>{job.location}</p></div></div><ul>{job.points.map((point) => <li>{point}</li>)}</ul></article></li>)}</ol>
      </section>
      <section id="projects" aria-labelledby="projects-title">
        <h2 id="projects-title">Selected work</h2>
        <div class="resume-project"><h3><a href="/work/elio/">Elio <Arrow /></a></h3><p class="job-role">Product design & frontend implementation</p><p>Designed and implemented a clinical-note workflow, from structured intake to reviewing and editing generated notes.</p></div>
        <div class="resume-project"><h3><a href="/work/del-campo/">Del Campo Stores <Arrow /></a></h3><p class="job-role">Website design & platform implementation</p><p>Designed and implemented the company’s first website, including responsive catalog navigation, product pages, and recurring interface components.</p></div>
      </section>
      <section id="skills" aria-labelledby="skills-title"><h2 id="skills-title">Skills & tools</h2><dl class="resume-skills">{skills.map((skill) => <div><dt>{skill.label}</dt><dd>{skill.text}</dd></div>)}</dl></section>
      <section id="education" aria-labelledby="education-title"><h2 id="education-title">Education</h2><div class="education-item"><h3>Foundations in Computer Science</h3><p>Holberton School · 2025</p></div><div class="education-item"><h3>Technician in Graphic Design</h3><p>ORT University · 2009</p></div></section>
      <section id="languages" aria-labelledby="languages-title"><h2 id="languages-title">Languages</h2><dl class="resume-skills"><div><dt>Spanish</dt><dd>Native</dd></div><div><dt>English</dt><dd>B2 level</dd></div></dl></section>
      <div class="resume-closing"><p>Looking for a designer who can bring the interface to life?</p><a class="text-link" href="mailto:fer.falcon.dg@gmail.com">Let’s talk <Arrow /></a></div>
    </div>
  </main>
  <SiteFooter />
</Layout>
<style>
  .resume-heading { padding-block: clamp(3rem, 6vw, 6rem) 0; }
  .eyebrow { font-size: .875rem; font-weight: 600; margin-block-end: 1.5rem; }
  h1 { max-inline-size: 14ch; }
  h1 span { color: var(--color-accent); }
  .resume-role { font-family: var(--font-display); font-size: clamp(1.5rem, 3vw, 2.4rem); letter-spacing: -.025em; margin-block-start: 1.5rem; }
  .resume-summary { max-inline-size: 62ch; margin-block-start: 1rem; font-size: 1.1875rem; }
  .file-type { font-size: .8125rem; font-weight: 400; }
  .resume-availability { display: flex; flex-wrap: wrap; gap: .5rem 2rem; border-block-start: 1px solid #8aaac8; margin-block-start: 3rem; padding-block: 1.5rem; font-size: .9375rem; }
  .resume-body { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 3fr); gap: clamp(2rem, 6vw, 6rem); padding-block: clamp(3rem, 6vw, 6rem); }
  .resume-sidebar { align-self: start; }
  .resume-sidebar h2 { font-size: 1rem; letter-spacing: 0; margin-block-end: .75rem; }
  .resume-sidebar a { display: flex; align-items: center; gap: .5rem; min-block-size: 44px; inline-size: fit-content; overflow-wrap: anywhere; font-size: .9375rem; }
  .resume-index { margin-block-start: 2.5rem; }
  .resume-content > section + section { margin-block-start: 3.5rem; }
  .resume-content h2 { font-size: clamp(1.8rem, 3vw, 2.6rem); }
  .section-note { margin-block-start: 1rem; color: var(--color-muted); }
  .resume-jobs { list-style: none; padding: 0; margin: 2rem 0 0; }
  .resume-jobs > li { border-block-start: 1px solid var(--color-line); padding-block: 1.75rem; }
  .job-heading { display: flex; justify-content: space-between; flex-wrap: wrap; gap: .75rem 2rem; }
  .job-role { color: var(--color-accent-hover); margin-block-start: .3rem; font-weight: 500; }
  .job-meta { color: var(--color-muted); font-size: .875rem; font-variant-numeric: tabular-nums; }
  article ul { padding-inline-start: 1.25rem; margin-block: 1rem 0; color: var(--color-muted); max-inline-size: 70ch; }
  article ul li + li { margin-block-start: .5rem; }
  .resume-project, .education-item { border-block-start: 1px solid var(--color-line); padding-block-start: 1.5rem; margin-block-start: 1.5rem; }
  .resume-project h3 a { display: inline-flex; align-items: center; gap: .75rem; min-block-size: 44px; }
  .resume-project > p:last-child { margin-block-start: .75rem; max-inline-size: 65ch; color: var(--color-muted); }
  .resume-skills { margin: 1.5rem 0 0; }
  .resume-skills > div { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2.5fr); gap: 1rem; padding-block: 1rem; border-block-start: 1px solid var(--color-line); }
  .resume-skills dt { font-weight: 600; }
  .resume-skills dd { margin: 0; color: var(--color-muted); }
  .education-item p { margin-block-start: .5rem; color: var(--color-muted); }
  .resume-closing { margin-block-start: 3.5rem; border-block-start: 1px solid var(--color-line); padding-block-start: 1.5rem; }
  .resume-closing .text-link { margin-block-start: .5rem; }
  @media (max-width: 700px) {
    .resume-body { grid-template-columns: minmax(0, 1fr); }
    .resume-sidebar { display: flex; flex-wrap: wrap; gap: 2rem; }
    .resume-index { margin: 0; }
    .resume-skills > div { grid-template-columns: minmax(0, 1fr); gap: .4rem; }
    .resume-content > section + section { margin-block-start: 2.5rem; }
  }
  @media print {
    :global(body) { background: white; color: black; font-size: 10pt; }
    :global(.site-header), :global(.site-footer), :global(.skip-link), .hero-actions, .resume-index, .resume-closing { display: none; }
    :global(.opening) { background: white; }
    :global(.wrap) { inline-size: 100%; }
    .resume-heading { padding: 0; }
    h1 { font-size: 30pt; max-inline-size: none; }
    .eyebrow { margin-block-end: .5rem; }
    .resume-role { font-size: 16pt; margin-block-start: .5rem; }
    .resume-summary { font-size: 10pt; }
    .resume-availability { margin-block-start: 1rem; padding-block: .5rem; }
    .resume-body { display: block; padding-block: 1rem; }
    .resume-sidebar { margin-block-end: 1rem; }
    .resume-contact { display: flex; flex-wrap: wrap; gap: .25rem 1rem; }
    .resume-contact h2 { display: none; }
    .resume-contact a { min-block-size: 0; font-size: 9pt; }
    :global(.arrow) { display: none; }
    .resume-content h2 { font-size: 16pt; break-after: avoid; }
    h3 { font-size: 12pt; }
    .resume-content > section + section { margin-block-start: 1.5rem; }
    .resume-jobs { margin-block-start: 1rem; }
    .resume-jobs > li { padding-block: 1rem; break-inside: avoid; }
    .resume-project, .education-item, .resume-skills > div { break-inside: avoid; }
    .resume-project h3 a { min-block-size: 0; }
    a { text-decoration: none; }
  }
</style>
